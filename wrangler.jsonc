{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newdo",
  "compatibility_date": "2026-09-01",
  // Static site: Next.js `output: "export"` writes to ./out. No Worker code.
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
